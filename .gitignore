next-env.d.ts
# production
*.tsbuildinfo
# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# env files
.env
.env.*
!.env.example
.secret_key
.enc_key
# prisma
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
# shell / misc artifacts
pwd_output.txt
AppData/
workspaces/
artifacts/
browser-screenshots/
checkpoints/
uploads/
.hermos/
# screenshots & temp files
*.png
*.jpg
*.jpeg
*.gif
*.webp
!public/**
# the landing page's generated assets must be tracked (deployed via Pages)
!hermos-website/*.png
!hermos-website/*.webp
verify-*.png
qa-*.png
/tmp/
# IDE
.idea/
.vscode/
*.swp
*.swo
*~
# OS
.DS_Store
Thumbs.db
# logs
dev.log
server.log
*.log
# upload
/upload/
/download/
