.next-build/
# agent artifacts
skills/
.zscripts/
worklog.md
AGENTS.md
agent-ctx/
.agents/
PROJECT.md
# Tauri build artifacts
src-tauri/node-bin/
src-tauri/target/
# Tauri bundle icons are referenced by src-tauri/tauri.conf.json and must be
# tracked so clean checkouts / CI can bundle installers — unignore them
# despite the global image excludes above.
!src-tauri/icons/*.png
# dead / renamed artifacts
examples/
mini-services/
# local installers
public/installers/
DEPLOYMENT.md
Caddyfile
# build cache
.turbo/
.eslintcache
.cache/
coverage/
# Prisma default database
prisma/hermos.db
prisma/db/
# tests ship with the open-source repo (CI quality gate runs them);
# only generated test artifacts stay ignored
src-tauri/binaries/
# perf harness (generated reports only)
perf-reports/
