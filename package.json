    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "agent-browser": "^0.39.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.11.0",
    "framer-motion": "^12.43.0",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^0.577.0",
    "next": "^16.4.2",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "react-syntax-highlighter": "^16.1.2",
    "recharts": "^2.15.4",
