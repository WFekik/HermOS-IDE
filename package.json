{
  "name": "hermos-ide",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 127.0.0.1",
    "build": "node scripts/nextjs-build.mjs",
    "build:desktop": "node scripts/provision-node-sidecar.mjs && prisma generate && node scripts/nextjs-build.mjs",
    "start": "node scripts/start-standalone.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "perf": "vitest run --config vitest.perf.config.ts --no-file-parallelism",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "test": "vitest run --pool=forks",
    "version:get": "node scripts/version.mjs get",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync",
    "version:bump": "node scripts/version.mjs bump",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=22"
  },
