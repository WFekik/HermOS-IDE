# HermOS Environment Variables Example
# HermOS is a LOCAL-ONLY desktop IDE — no cloud, no auth, no external services.
# Only the two variables below are read at runtime; everything else is optional.

# Database (SQLite)
# Resolved at runtime by src/lib/db.ts: when unset, an absolute file: URL under
# the app-data dir (~/.hermos in dev, %APPDATA%/com.hermos.ide on desktop) is
# derived automatically. Only set this to override that location:
# DATABASE_URL="file:C:/Users/<you>/.hermos/db/hermos.db"

# Encryption Key for BYOK Provider Keys (32-byte hex string = 64 hex characters)
# When unset, a persistent key is auto-generated and stored at
# <app-data-dir>/.secret_key on first run.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=""

# Optional: disable the terminal / run_command tools server-side
# Default: enabled (unset or "true")
# HERMOS_ENABLE_COMMANDS="false"

# SSRF policy for the agent http_fetch / download tools
# Default: STRICT — RFC1918 private, loopback and link-local ranges are
# BLOCKED for agent fetches, EXCEPT the local-AI allowlist (localhost,
# 127.0.0.1, ::1, 0.0.0.0 on any port — Ollama / LM Studio / llama.cpp etc.,
# so local dev and the browser integration keep working). Set
# SSRF_BLOCK_PRIVATE="false" to also allow other private-network hosts
# (e.g. a LAN Ollama box). Link-local / cloud-metadata ranges are ALWAYS
# blocked regardless of this flag.
# SSRF_BLOCK_PRIVATE="false"

# Optional Agent Command Timeouts (milliseconds)
# COMMAND_BLOCK_TIMEOUT_MS: how long run_command blocks the agent turn waiting
#   for completion before returning status="running" with partial output
#   (default 600000 = 10 min; abort-aware, so a user cancel resolves instantly).
# COMMAND_MAX_BLOCK_TIMEOUT_MS: absolute ceiling for the blocking window
#   (default 1800000 = 30 min, covering long builds)
# COMMAND_BLOCK_TIMEOUT_MS="600000"
# COMMAND_MAX_BLOCK_TIMEOUT_MS="1800000"

# Desktop server port override
# Read by the Tauri shell when spawning the local Next.js server; must fall
# within the fixed window 3001-3999 or it is ignored (auto-pick instead).
# HERMOS_DESKTOP_PORT="3100"

# Tool-result size cap (characters) for file reads / diffs, with a visible
# truncation notice. Default: 100000.
# MAX_READ_FILE_CHARS="100000"

# Max agent iterations per run. Default: unlimited (Infinity).
# Set a finite integer as an optional global safety ceiling.
# HERMOS_MAX_AGENT_ITERATIONS=""

# BufferedToolCallStream hold-back limit (characters). Controls how much text
# is buffered while waiting for a tool-call fence to close. Default: 100000.
# HERMOS_STREAM_BUFFER_LIMIT="100000"

# Terminal command timeout (milliseconds) used by workspace command runners.
# Default: 1800000 (= 30 min).
# CMD_TIMEOUT_MS="1800000"

# Set to "true" ONLY behind a reverse proxy you control: enables trusting
# X-Forwarded-* headers for client-IP resolution in rate limiting.
# TRUST_PROXY="false"

# Optional sandboxed command execution (server deployments only — the desktop
# app runs commands locally). Opt in by setting HERMOS_SANDBOX_TYPE to
# "container" or "microvm", OR by pointing at a container-pool service URL;
# both URL spellings are accepted. API key is optional auth for that service.
# HERMOS_SANDBOX_TYPE=""
# HERMOS_SANDBOX_URL=""
# SANDBOX_SERVICE_URL=""
# HERMOS_SANDBOX_API_KEY=""
# SANDBOX_API_KEY=""

# Project-root override for dev/browser mode path resolution (desktop mode
# points workspaces directly at user folders and does not need this).
# HERMOS_PROJECT_ROOT=""
